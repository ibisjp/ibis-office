{
  // main.ts compiles in place to main.js, next to the pkg/ that wasm-bindgen
  // writes, so its imports resolve the same in the browser and for tsc.
  "compilerOptions": {
    "target": "es2022",
    "module": "esnext",
    "moduleResolution": "bundler",
    "lib": ["es2022", "dom", "dom.iterable"],
    "strict": true,
    "noEmitOnError": true,
    "skipLibCheck": true,
    // ibisoffice-host.d.ts ships with the Web archive next to ibisoffice-host.js (the other .d.ts files are not used).
    "declaration": true
  },
  "files": ["main.ts", "boot.ts", "ibisoffice-host.ts"]
}
